{
  "name": "obs-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Pi coding-agent harness as an Obsidian panel, backed by a local bridge server",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "server": "node server.js",
    "test": "node test/format.mjs && node test/note-context.mjs && node test/smoke.mjs",
    "test:format": "node test/format.mjs && node test/note-context.mjs",
    "test:live": "node test/live.mjs",
    "install-plugin": "node scripts/install-plugin.mjs"
  },
  "keywords": [
    "obsidian-plugin",
    "pi",
    "coding-agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
